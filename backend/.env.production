# Production Environment Variables Template
# Copy this file to .env and update with actual values

# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_actual_mysql_password
DB_NAME=tutor_hub
DB_PORT=3306

# Server Configuration
PORT=3000
NODE_ENV=production

# JWT Configuration - Use a strong, randomly generated secret in production
JWT_SECRET_KEY=generate_strong_random_secret_here_at_least_32_characters

# Email Configuration - Use actual Gmail App Password
EMAIL_USER=tutorhub.abhaysir@gmail.com
EMAIL_PASS=your_actual_16_character_gmail_app_password

# Universal Email Support (optional - for multiple providers)
GMAIL_USER=tutorhub.abhaysir@gmail.com
GMAIL_PASS=your_actual_16_character_gmail_app_password
FRONTEND_URL=http://localhost:4200

# WhatsApp Configuration (optional)
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER=your_whatsapp_number
